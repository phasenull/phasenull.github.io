/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "phasenull-dev-frontend",
	"compatibility_date": "2025-08-21",
	// SEO front (worker/index.ts): page HTML with meta tags and content, robots.txt and sitemap.xml
	"main": "worker/index.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "none",
		// built files go straight to the asset server; everything else goes through the worker
		"run_worker_first": ["/*", "!/assets/*", "!/og/*"]
	},
	"vars": {
		// local dev: `wrangler dev --var API_URL:http://localhost:8787`
		"API_URL": "https://api.phasenull.dev"
	},
	"observability": {
		"enabled": true
	}
}
